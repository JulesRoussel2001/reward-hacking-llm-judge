# secrets
.env
*.key
# data & artifacts never committed
# (data/ is excluded entry-by-entry so the run ledger can be re-included below;
#  git cannot re-include a file whose parent directory is excluded outright)
data/*
!data/derived/
data/derived/*
# The experiment run ledger IS released with the paper (provenance).
!data/derived/EXPERIMENT_RUN_LEDGER.csv
external/
logs/
*.jsonl
*.npz
*.safetensors
*.bin
*.gguf
# Judgment-level run logs ARE released with the paper (Appendix C).
# Re-included after the *.jsonl rule above; runtime pid files stay out.
!runs/
!runs/**/*.jsonl
!runs/**/*.log
!runs/**/*.out
!runs/**/*.md
runs/*.pid
# python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
# misc
.DS_Store
